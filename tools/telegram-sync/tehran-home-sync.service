[Unit]
Description=Synchronize Tehran home catalog Telegram forum cards
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
ExecStart=/opt/aira-runtime/library-venv-v1/bin/python /opt/tehran-home-sync/sync.py
TimeoutStartSec=55min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tehran-home-sync
ProtectHome=true
